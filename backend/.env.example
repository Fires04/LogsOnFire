# Local development env file (backend/.env) — loaded automatically by
# pydantic-settings when running the backend directly (not via Docker).
# Copy to backend/.env and adjust as needed.

ENV=development
DB_PATH=./data/logsonfire.db

# Generate with: openssl rand -base64 32 / 48
# If left empty, an ephemeral key/secret is generated at startup with a
# loud warning — fine for local experimentation, never for real credentials.
AGENT_TOKEN_PEPPER=
JWT_SECRET=

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

TRUSTED_PROXY=false
LOG_BUFFER_MAX_LINES=20000
