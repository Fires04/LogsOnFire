# Copy this file to .env (same directory as docker-compose.yml) and fill in
# real values. `docker compose` reads .env automatically to fill in the
# ${VAR} references in docker-compose.yml — it is NOT copied into the image.

# Required. 32 random bytes, base64-encoded. Generate with:
#   openssl rand -base64 32
# HMAC pepper used to hash agent bearer tokens at rest (one-way, never
# reversible). Losing/rotating it invalidates every agent's stored token —
# reissue tokens and reconfigure each agent, but no log data is lost.
AGENT_TOKEN_PEPPER=

# Required. Signs login session tokens. Generate with:
#   openssl rand -base64 48
JWT_SECRET=

# First-boot admin account. If ADMIN_PASSWORD is left empty, a random one is
# generated and printed once to the container logs
# (`docker compose logs logsonfire`) — only on the very first startup, when
# the users table is still empty.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Set to true only if LogsOnFire runs behind a TLS-terminating reverse proxy
# (nginx/Traefik/Caddy) that sets X-Forwarded-Proto and X-Forwarded-For.
# Leave false for direct exposure or local testing.
TRUSTED_PROXY=false

# "production" marks the login cookies Secure (HTTPS-only) — only correct
# behind a TLS-terminating reverse proxy. Accessing the container directly
# over plain HTTP (LAN/local testing, no proxy) needs "development", or the
# browser silently drops the cookies and you get bounced back to the login
# page right after logging in.
ENV=production
